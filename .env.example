# Copy to .env and adjust if needed. None of these are required to run the
# project locally - sensible defaults are baked into config/settings.py.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Vehicle assumptions (per the assignment spec)
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
VEHICLE_RANGE_SAFETY_MARGIN_MILES=25

# How far (miles) a fuel station may sit from the route and still count as "on the route"
FUEL_STATION_CORRIDOR_MILES=5

# Free, keyless external services
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=fuel-route-api/1.0 (your-email@example.com)
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
